# =============================================================================
# Variables d'environnement — Site vitrine umbrella (Aquasystem [PROVISOIRE])
# =============================================================================
# COPIER ce fichier en .env.local (dev) — NE JAMAIS commiter de valeur réelle.
# En production : saisir ces variables dans le dashboard Cloudflare Pages.
# Détail de configuration : docs/infra/infrastructure.md
# -----------------------------------------------------------------------------

# --- Pages Function /api/contact (côté serveur — secrets) ---------------------

# Clé API du service email Resend. Format "re_xxxxxxxx".
# Obtenir sur https://resend.com/api-keys. Secret Cloudflare (jamais NEXT_PUBLIC_).
RESEND_API_KEY=

# Adresse email destinataire des leads (boîte de Nicolas Berg).
# Valeur de production : contact@aqua-system.fr
CONTACT_EMAIL_TO=

# Adresse expéditrice technique (domaine vérifié SPF/DKIM/DMARC chez Resend).
# Ex: noreply@<domaine-ombrelle>.fr
CONTACT_EMAIL_FROM=

# --- Rate limiting du formulaire (anti-spam) ---------------------------------

# Fenêtre de rate limiting en secondes (défaut 3600 = 1h).
RATE_LIMIT_WINDOW_SECONDS=3600

# Nombre max de soumissions par IP sur la fenêtre (défaut 5).
RATE_LIMIT_MAX=5

# Binding du namespace KV utilisé pour le compteur de rate limiting.
# Le binding est défini dans le dashboard Cloudflare Pages (Settings > Functions
# > KV namespace bindings). La variable ci-dessous documente le NOM du binding
# attendu par le code (functions/api/contact.ts lit env.RATE_LIMIT_KV).
RATE_LIMIT_KV_BINDING=RATE_LIMIT_KV

# --- Analytics Umami (côté client — préfixe NEXT_PUBLIC_, non secret) ---------

# Identifiant du site Umami (UUID). Si absent : script non chargé, trackEvent no-op.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# URL du script Umami self-hosted (VPS fondateur) ou Umami Cloud.
# Ex self-host : https://analytics.<domaine>.fr/script.js
# Ex cloud     : https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_URL=

# --- URL canonique du site (SEO, sitemap, OG) --------------------------------

# URL de production, sans slash final. Ex: https://www.<domaine-ombrelle>.fr
NEXT_PUBLIC_SITE_URL=
