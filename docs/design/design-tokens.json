        "body-sm": { "$value": "{primitives.line-height.normal}",  "$type": "dimension", "$description": "28px — corps compact" },
        "heading": { "$value": "{primitives.line-height.tight}",   "$type": "dimension", "$description": "20px — overrides via h1/h2 tokens spécifiques" },
        "h1":      { "$value": "{primitives.line-height.h1}",      "$type": "dimension", "$description": "64px" },
