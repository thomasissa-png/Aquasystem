      "sm":  { "$value": "0 2px 4px rgba(42,36,32,0.08)",            "$type": "shadow" },
      "md":  { "$value": "0 4px 12px rgba(42,36,32,0.10)",           "$type": "shadow" },
      "lg":  { "$value": "0 8px 24px rgba(42,36,32,0.12)",           "$type": "shadow" },
      "xl":  { "$value": "0 16px 48px rgba(42,36,32,0.16)",          "$type": "shadow" },
      "none": { "$value": "none", "$type": "shadow" }
    },

    "duration": {
      "instant": { "$value": "0ms",    "$type": "duration" },
