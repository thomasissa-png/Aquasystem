      "name-size":    { "$value": "{semantic.typography.size.2xl}",     "$type": "dimension", "$description": "D-26 ajouté — 24px desktop (text-2xl) / 20px mobile (text-xl) pour kind:'name' (Socotec, L'Esprit Piscine) : corps réduit pour tenir sur UNE ligne (whitespace-nowrap)." },
