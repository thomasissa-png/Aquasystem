        "700": { "$value": "#9A7035", "$type": "color", "$description": "Ajouté v1.1 BUG-A11Y-1 — texte or moyen si besoin grand texte ≥24px (ratio 3.18:1 sur #EDD9B8)" },
        "800": { "$value": "#8B6130", "$type": "color", "$description": "Texte or sombre — ratio 3.92:1 sur fond proof #EDD9B8, PASS grand texte ≥24px" }
