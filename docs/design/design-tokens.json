        "spring":  { "$value": "{primitives.easing.spring}",  "$type": "cubicBezier" }
      },
      "reduced-motion": {
        "note": "$description: Appliquer prefers-reduced-motion: reduce → toutes les durées passent à instant(0ms) sauf les transitions fonctionnelles (scroll d'ancre, focus trap). Implémenter via CSS: @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }"
      }
