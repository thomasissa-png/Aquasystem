        "600": { "$value": "#7E7468", "$type": "color" },
        "700": { "$value": "#6B6058", "$type": "color" },
        "800": { "$value": "#4A3E34", "$type": "color" },
        "900": { "$value": "#2A2420", "$type": "color" },
        "950": { "$value": "#1A1510", "$type": "color" }
      },
      "water": {
