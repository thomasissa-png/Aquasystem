    "easing": {
      "default":    { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",  "$type": "cubicBezier", "$description": "ease-in-out standard" },
      "out":        { "$value": "cubic-bezier(0, 0, 0.2, 1)",    "$type": "cubicBezier", "$description": "ease-out — éléments entrants" },
      "in":         { "$value": "cubic-bezier(0.4, 0, 1, 1)",    "$type": "cubicBezier", "$description": "ease-in — éléments sortants" },
      "spring":     { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "légèrement élastique — hover boutons" }
    }
