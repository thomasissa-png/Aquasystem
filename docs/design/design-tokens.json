  "semantic": {
    "$description": "Tier 2 — tokens sémantiques light mode (défaut). Les composants utilisent UNIQUEMENT ces tokens.",

    "color": {
      "background": {
        "primary":   { "$value": "{primitives.color.sand.100}", "$type": "color", "$description": "#F5F0E8 — fond de page" },
        "secondary": { "$value": "{primitives.color.sand.200}", "$type": "color", "$description": "#EDE8DF — sections alternées, cartes" },
        "tertiary":  { "$value": "{primitives.color.sand.300}", "$type": "color", "$description": "#E0D8CC — input backgrounds" },
        "inverse":   { "$value": "{primitives.color.sand.950}", "$type": "color", "$description": "#1A1510 — fond sombre (hero overlay, footer)" },
        "overlay":   { "$value": "rgba(26,21,16,0.72)",         "$type": "color", "$description": "overlay hero — assure 4.5:1 sur texte blanc" },
        "accent-water":  { "$value": "{primitives.color.water.200}", "$type": "color", "$description": "#B8D4DC — bg subtil section piscine" },
        "accent-forest": { "$value": "{primitives.color.forest.200}", "$type": "color", "$description": "#C4D9C6 — bg subtil section jardin" },
        "proof":     { "$value": "{primitives.color.gold.100}", "$type": "color", "$description": "#EDD9B8 — bg section preuves/chiffres" }
      },

      "text": {
        "primary":   { "$value": "{primitives.color.sand.900}", "$type": "color", "$description": "#2A2420 — corps, titres sur fond clair" },
        "secondary": { "$value": "{primitives.color.sand.700}", "$type": "color", "$description": "#6B6058 — labels, captions, métadonnées" },
        "muted":     { "$value": "{primitives.color.sand.700}", "$type": "color", "$description": "#6B6058 — placeholders, texte désactivé. Corrigé v1.2 BUG-A11Y-3 : sand.600 #7E7468 = 3.75:1 sur sand-200 (FAIL) → sand.700 #6B6058 = 4.58:1 sur sand-200 et 4.95:1 sur sand-100 (PASS AA)." },
        "inverse":   { "$value": "{primitives.color.sand.100}", "$type": "color", "$description": "#F5F0E8 — texte sur fond sombre" },
        "accent-water":  { "$value": "{primitives.color.water.600}",  "$type": "color", "$description": "#3A6675 — liens actifs, accent eau" },
        "accent-forest": { "$value": "{primitives.color.forest.600}", "$type": "color", "$description": "#3B5240 — liens jardin, accent végétal" },
        "proof":     { "$value": "{primitives.color.gold.800}", "$type": "color", "$description": "#8B6130 — chiffres de preuve (30+, 350+, 48px DM Serif). Modifié v1.1 BUG-A11Y-1 : gold.600→gold.800 pour ratio 3.92:1 sur #EDD9B8 (grand texte ≥24px, PASS AA). gold.600 réservé décoratif." },
        "proof-label": { "$value": "{primitives.color.sand.800}", "$type": "color", "$description": "#4A3E34 — labels sous les chiffres proof (14px/medium, texte normal). Ajouté v1.1 BUG-A11Y-1 : ratio 7.39:1 sur #EDD9B8, PASS AAA. Remplace text.secondary (#6B6058 = 4.42:1, insuffisant)." },
        "footer-legal": { "$value": "{primitives.color.sand.500}", "$type": "color", "$description": "#A89E92 — texte barre légale footer (12px xs) sur fond inverse #1A1510. Ajouté v1.1 BUG-A11Y-1 : ratio 6.87:1, PASS AAA. Remplace text.muted sand.600 = 3.99:1 insuffisant." },
        "error":     { "$value": "{primitives.color.status.error-dark}", "$type": "color" },
        "success":   { "$value": "{primitives.color.status.success-dark}", "$type": "color" }
      },

      "border": {
        "default": { "$value": "{primitives.color.sand.400}", "$type": "color", "$description": "#D4CCC0 — bordures cartes, séparateurs" },
        "strong":  { "$value": "{primitives.color.sand.500}", "$type": "color", "$description": "#A89E92 — bordures focus, champs actifs" },
        "muted":   { "$value": "{primitives.color.sand.300}", "$type": "color", "$description": "#E0D8CC — séparateurs très discrets" },
        "error":   { "$value": "{primitives.color.status.error-dark}", "$type": "color" },
        "success": { "$value": "{primitives.color.status.success-dark}", "$type": "color" }
      },

      "action": {
        "primary-bg":        { "$value": "{primitives.color.water.600}",  "$type": "color", "$description": "#3A6675 — CTA primaire fond" },
        "primary-bg-hover":  { "$value": "{primitives.color.water.500}",  "$type": "color", "$description": "#5A8A9A — CTA primaire hover" },
        "primary-bg-active": { "$value": "{primitives.color.water.700}",  "$type": "color", "$description": "#2C4F5C — CTA primaire active" },
        "primary-text":      { "$value": "{primitives.color.white}",      "$type": "color", "$description": "#FFFFFF — texte sur CTA primaire" },

        "secondary-bg":        { "$value": "transparent",                     "$type": "color", "$description": "CTA ghost" },
        "secondary-border":    { "$value": "{primitives.color.water.600}",    "$type": "color" },
        "secondary-text":      { "$value": "{primitives.color.water.600}",    "$type": "color" },
        "secondary-bg-hover":  { "$value": "{primitives.color.water.50}",     "$type": "color" },
        "secondary-border-hover": { "$value": "{primitives.color.water.500}", "$type": "color" },

        "forest-bg":        { "$value": "{primitives.color.forest.600}", "$type": "color", "$description": "#3B5240 — CTA section jardins" },
        "forest-bg-hover":  { "$value": "{primitives.color.forest.500}", "$type": "color" },
        "forest-bg-active": { "$value": "{primitives.color.forest.700}", "$type": "color" },

        "disabled-bg":   { "$value": "{primitives.color.sand.300}", "$type": "color" },
        "disabled-text": { "$value": "{primitives.color.sand.500}", "$type": "color" }
      },

      "focus": {
        "ring":        { "$value": "{primitives.color.water.600}", "$type": "color", "$description": "#3A6675 — outline focus sur fond clair" },
        "ring-inverse": { "$value": "{primitives.color.sand.100}", "$type": "color", "$description": "#F5F0E8 — outline focus sur fond sombre (hero, overlay)" }
      }
    },

