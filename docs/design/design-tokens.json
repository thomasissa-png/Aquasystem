        "200": { "$value": "#C4D9C6", "$type": "color" },
        "300": { "$value": "#A0BFA3", "$type": "color" },
        "400": { "$value": "#789A7C", "$type": "color" },
        "500": { "$value": "#587A5F", "$type": "color" },
