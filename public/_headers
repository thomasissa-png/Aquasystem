# Cloudflare Pages — en-têtes de sécurité (appliqués à toutes les réponses).
# Doc : https://developers.cloudflare.com/pages/configuration/headers/
# Vérifier sur securityheaders.com après déploiement (cible : note A).

/*
  # Empêche le sniffing de type MIME.
  X-Content-Type-Options: nosniff
  # Anti-clickjacking (site sans iframe légitime).
  X-Frame-Options: DENY
  # Ne fuite pas l'URL complète en cross-origin.
  Referrer-Policy: strict-origin-when-cross-origin
  # Désactive des API navigateur non utilisées.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # HSTS — Cloudflare force déjà le HTTPS ; on signale 2 ans + preload.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP — restrictive. Ajuster le connect-src/script-src au domaine Umami final.
  # 'unsafe-inline' sur style-src : requis par Next/Tailwind (styles inline runtime).
  # script-src : self + script Umami (remplacer le domaine au déploiement).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.umami.is https://api.resend.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
