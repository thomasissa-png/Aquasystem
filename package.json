{
  "name": "aquasystem",
  "version": "0.1.0",
  "private": true,
  "description": "Site vitrine umbrella Aqua System x Les Terres Essentielles (nom ombrelle provisoire). Next.js export statique sur Cloudflare Pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"functions/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.456.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.49.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.6",
    "jsdom": "25.0.1",
    "postcss": "8.4.39",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
